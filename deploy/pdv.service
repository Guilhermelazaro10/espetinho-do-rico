[Unit]
Description=Espetinho do Rico - PDV (API + SPA)
After=network.target

[Service]
Type=simple
User=espetinho
WorkingDirectory=/opt/espetinho/backend
EnvironmentFile=/opt/espetinho/backend/.env.production
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3

# Desligamento gracioso: o SIGTERM faz o Node parar de aceitar conexão nova e
# esperar as requisições em voo (SHUTDOWN_TIMEOUT_MS, 10s + 5s de folga).
# TimeoutStopSec precisa ser MAIOR que isso, senão vem SIGKILL no meio de um
# pagamento. Se aumentar um, aumente o outro.
KillSignal=SIGTERM
TimeoutStopSec=20

# Endurecimento básico do processo
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ReadWritePaths=/opt/espetinho/data /opt/espetinho/backend/cupons

[Install]
WantedBy=multi-user.target
